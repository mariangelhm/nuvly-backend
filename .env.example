APP_NAME=Nuvly Backend
APP_ENV=development
API_PREFIX=/api
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nuvly_dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Backend public origin used to build absolute asset URLs in API responses.
# Local example: http://localhost:8000
# UAT example: https://api-uat.nuvlystudio.com
PUBLIC_BASE_URL=http://localhost:8000
# Frontend public origin used for checkout and public project URLs.
# Local example: http://localhost:5173
# UAT example: https://uat.nuvlystudio.com
FRONTEND_PUBLIC_BASE_URL=http://localhost:5173
MEDIA_MAX_SIZE_MB=5
