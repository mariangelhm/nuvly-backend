APP_NAME=Nuvly Backend
APP_ENV=development
API_PREFIX=/api
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nuvly_dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Backend public origin used to build absolute asset URLs in API responses.
# Local example: http://localhost:8000
# UAT example: https://api-uat.nuvlystudio.com
PUBLIC_BASE_URL=http://localhost:8000
# Frontend public origin used for checkout and public project URLs.
# Local example: http://localhost:5173
# UAT example: https://uat.nuvlystudio.com
FRONTEND_PUBLIC_BASE_URL=http://localhost:5173
MEDIA_MAX_SIZE_MB=5
MEDIA_OWNER_DAILY_UPLOAD_MB=100
# Production requires an absolute mounted durable directory and tested backups.
MEDIA_STORAGE_ROOT=
MEDIA_STORAGE_DURABLE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Nuvly
SMTP_USE_TLS=true
SUPPORT_CONTACT_EMAIL=nuvlystudio@gmail.com
AUTH_SESSION_TTL_DAYS=30
# Public OAuth client ID, application type Web. No client secret is needed.
GOOGLE_CLIENT_ID=
AUTH_RESET_PASSWORD_TTL_MINUTES=10

# Integration by default. Enable production only after authorized staging validation.
PAYMENTS_ENVIRONMENT=integration
PAYMENTS_PRODUCTION_ENABLED=false
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
# Set this privately in the backend environment after creating your MP test app.
MERCADOPAGO_TEST_ACCESS_TOKEN=
# Optional: needed only for signed MP notifications at a public HTTPS backend.
MERCADOPAGO_TEST_WEBHOOK_SECRET=
# Webpay Plus uses the public integration credentials from the official SDK.
